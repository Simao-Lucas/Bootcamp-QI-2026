{
  "title": "PostEmployee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "document_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    },
    "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "hired_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "position_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    }
  },
  "required": [
    "name",
    "document_number",
    "email",
    "hired_at",
    "position_key"
  ],
  "additionalProperties": false
}
